# ========== MySQL ==========
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=adas_db

# ========== JWT ==========
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
SECRET_KEY=your_secret_key
REFRESH_SECRET_KEY=your_refresh_secret_key

# ========== AI Server ==========
AI_SERVER_URL=http://localhost:8500
GRPC_SERVER_URL=localhost:8500

# ========== Email (Gmail SMTP) ==========
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# TTL (giây) — tuỳ chỉnh nếu cần
REDIS_OTP_TTL=300          # OTP hết hạn sau 5 phút
REDIS_SESSION_TTL=604800   # Session cache tối đa 7 ngày
REDIS_PERMISSION_TTL=300   # Permission cache hết hạn sau 5 phút
